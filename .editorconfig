# Rules added or tightened in StyleCop.Analyzers 1.3 that the existing code base predates
# SA1121: Use built-in type alias (IntPtr -> nint across P/Invoke interop code)
dotnet_diagnostic.SA1121.severity = none
# SA1143: Conditional expressions must be formatted consistently
dotnet_diagnostic.SA1143.severity = none
# SA1315: Parameter names must match inherited names (renaming would break the public API for named arguments)
dotnet_diagnostic.SA1315.severity = none
# SA1504: All accessors should be single-line or multi-line
dotnet_diagnostic.SA1504.severity = none

# The callback delegates are intentionally declared alongside the interface that consumes them
[Unosquare.FFME/Common/IMediaInputStream.cs]
dotnet_diagnostic.SA1649.severity = none
